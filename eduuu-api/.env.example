NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500
PUBLIC_FRONTEND_URL=http://127.0.0.1:5500/main.html

# Configure an SMTP provider before enabling email-verified admin registration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
